{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Precisa ser IGUAL ao nome do Worker no painel da Cloudflare (Workers & Pages).
  "name": "portfolio",
  "compatibility_date": "2026-09-29",
  // O site é estático (arquivos gerados em ./dist). O único código de servidor é worker/index.ts,
  // que atende /api/dominio (verificação de nomes de endereço livres) e escolhe o idioma em "/".
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Passam pelo Worker primeiro: /api/* e as entradas sem idioma ("/" e o antigo "/orcamento/"),
    // que ele encaminha para /pt/, /en/ ou /es/. Todo o resto é servido direto pela Cloudflare.
    "run_worker_first": ["/api/*", "/", "/orcamento", "/orcamento/"],
    // Caminho inexistente devolve public/404.html (com status 404) em vez de cair no index.html.
    "not_found_handling": "404-page"
  },
  // Limite por IP na verificação de nomes: 20 consultas por minuto.
  "ratelimits": [
    {
      "name": "DOMAIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
  // Segredos (NÃO ficam aqui; ver docs/DEPLOY.md): CLOUDFLARE_ACCOUNT_ID e CLOUDFLARE_API_TOKEN.
}
